{
  "manifest_version": 3,
  "name": "엔트리루트 애니메이터",
  "version": "1.1.0",
  "description": "엔트리용 비공식 확장. 모양 편집기에 뼈대 변형, 부드러운 붓·지우개, 영역 채우기, 투명도, 어니언스킨, 스프라이트 시트 나누기, 중심 맞추기를 더합니다.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["https://playentry.org/ws/*"],
    "run_at": "document_idle",
    "world": "MAIN",
    "js": ["vendor/IK-browser.js", "vendor/warp.js", "vendor/delaunator.min.js", "vendor/gl-matrix-min.js", "vendor/perfect-freehand.js", "vendor/one-euro-filter.js", "vendor/polygon-clipping.umd.min.js", "vendor/d3-array.min.js", "vendor/d3-contour.min.js", "rig.js"],
    "css": ["rig.css"]
  }]
}
