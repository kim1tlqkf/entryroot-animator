{
  "manifest_version": 3,
  "name": "엔트리루트 애니메이터",
  "version": "1.3.2",
  "description": "엔트리용 비공식 확장. 모양 편집기에 레이어·클리핑, 뼈대 변형, 부드러운 붓·사각 펜, 영역 채우기, 캔버스 크기·무한 배경, 픽셀 아트, 어니언스킨, 스프라이트 시트 나누기를 더합니다.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["https://playentry.org/ws/*"],
    "run_at": "document_idle",
    "world": "MAIN",
    "js": ["vendor/IK-browser.js", "vendor/warp.js", "vendor/delaunator.min.js", "vendor/gl-matrix-min.js", "vendor/one-euro-filter.js", "vendor/d3-array.min.js", "vendor/d3-contour.min.js", "vendor/ag-psd.js", "vendor/bresenham-zingl.js", "rig.js"],
    "css": ["rig.css"]
  }]
}
